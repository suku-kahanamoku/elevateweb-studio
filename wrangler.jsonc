{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevateweb-studio",
  "compatibility_date": "2026-07-27",
  "main": "worker.js",
  "vars": {
    "BACKEND_URL": "https://www.charter-agency.com",
    "BACKEND_PATH": "/api/mailer"
  },
  "assets": {
    "directory": "./"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"]
}
